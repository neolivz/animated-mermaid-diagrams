{
  "name": "animated-mermaid-diagrams",
  "version": "0.1.0",
  "description": "Drop-in animated rendering for Mermaid diagrams. One dependency: @dagrejs/dagre (the same layout engine Mermaid uses).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jishnu Viswanath",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/animated-mermaid-diagrams.umd.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm test && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "animation",
    "svg",
    "sequence-diagram",
    "flowchart",
    "state-diagram"
  ],
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1"
  }
}
