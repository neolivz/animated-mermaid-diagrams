{
  "name": "animated-mermaid-diagrams",
  "version": "1.1.0",
  "description": "Drop-in animated rendering for Mermaid diagrams. One dependency: @dagrejs/dagre (the same layout engine Mermaid uses).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Jishnu Viswanath",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/animated-mermaid-diagrams.umd.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm test && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "animation",
    "svg",
    "sequence-diagram",
    "flowchart",
    "state-diagram"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neolivz/animated-mermaid-diagrams.git"
  },
  "homepage": "https://neolivz.github.io/animated-mermaid-diagrams/demo/",
  "bugs": {
    "url": "https://github.com/neolivz/animated-mermaid-diagrams/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
